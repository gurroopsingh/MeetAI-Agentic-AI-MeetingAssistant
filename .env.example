# MeetAI Environment Variables
# Copy this file to .env and fill in your values

# ── Backend ──────────────────────────────────────────
# AI Provider mode: "mock" (default) | "azure" (future)
AI_PROVIDER=mock

# Database (SQLite default — no change needed for local dev)
DATABASE_URL=sqlite:///./meetai.db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ── Azure AI Speech (future) ──────────────────────────
# Uncomment and fill when connecting Azure
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus

# ── Azure AI Language (future) ────────────────────────
# AZURE_LANGUAGE_KEY=your_azure_language_key
# AZURE_LANGUAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# ── Microsoft Foundry / Azure OpenAI (future) ─────────
# AZURE_OPENAI_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
