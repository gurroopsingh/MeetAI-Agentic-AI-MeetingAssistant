# MeetAI Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────
# Provider mode: "azure" (real) or "mock" (local dev)
AI_PROVIDER=mock

# Optional per-provider overrides (override AI_PROVIDER for individual services)
# SPEECH_PROVIDER=azure
# LANGUAGE_PROVIDER=azure
# GENAI_PROVIDER=foundry

DATABASE_URL=sqlite:///./meetai.db
CORS_ORIGINS=http://localhost:3000

# ── Microsoft Foundry (Azure OpenAI) ───────────────────────────────────────
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
FOUNDRY_API_KEY=<your-foundry-api-key>
FOUNDRY_DEPLOYMENT=gpt-4.1-mini

# ── Azure AI Language ──────────────────────────────────────────────────────
LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com/
LANGUAGE_API_KEY=<your-language-api-key>

# ── Azure AI Speech ─────────────────────────────────────────────────────────
SPEECH_API_KEY=<your-speech-api-key>
SPEECH_ENDPOINT=https://<region>.api.cognitive.microsoft.com/
